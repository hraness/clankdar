{
  "name": "clankdar",
  "private": true,
  "description": "Clankdar gives AI agents fresh puzzles to solve, scores their answers exactly, and signs a receipt anyone can recheck.",
  "homepage": "https://clankdar.com",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "bench": "bun bench/cli.ts",
    "gate": "bun bench/gate.ts",
    "tlog": "bun bench/tlog.ts",
    "badge": "bun bench/badge.ts",
    "holdout": "bun bench/holdout.ts",
    "hosted": "bun bench/hosted.ts",
    "drift": "bun bench/drift.ts",
    "admission-archive": "bun bench/admission-archive.ts",
    "calibrate": "bun bench/calibrate.ts",
    "report": "bun bench/report.ts",
    "check": "bun run typecheck && bun run typecheck:cloudflare && bun test && bun run build:site && bun run test:cloudflare",
    "typecheck": "tsc --noEmit",
    "typecheck:cloudflare": "tsc -p cloudflare/tsconfig.json",
    "test:cloudflare": "bun run prepare:algal && vitest run --config cloudflare/vitest.config.ts",
    "actor": "bun cloudflare/client.ts",
    "cloudflare:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cloudflare:types": "wrangler types --config cloudflare/wrangler.jsonc --path cloudflare/src/worker-configuration.d.ts",
    "cloudflare:dry-run": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc",
    "check:site": "bun test site && bun run build:site",
    "check:browser": "bun site/verify.ts",
    "build:site": "bun run site/build.ts && bun run cloudflare/build-assets.ts && bun run prepare:algal",
    "prepare:algal": "bun cloudflare/prepare-algal.ts",
    "algal:example": "bun bench/algal-example.ts",
    "try": "bun demo/cli.ts"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.18.2",
    "@hraness/site-footer": "github:hraness/site-footer#v0.19.2",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.8.0",
    "@hraness/algal": "github:hraness/algal#723c35d3c60d1ef7b88437a9ddeaf6588a1814cf"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@playwright/test": "1.58.2",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.131.1",
    "@hraness/ui": "github:hraness/ui#v0.5.18",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "imports": {
    "#clankdar-algal-runtime": {
      "workerd": "./ladder/algal/worker.ts",
      "default": "./ladder/algal/bun.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hraness/clankdar.git"
  }
}
