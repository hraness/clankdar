{
  "name": "clankdar",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "bench": "bun bench/cli.ts",
    "gate": "bun bench/gate.ts",
    "tlog": "bun bench/tlog.ts",
    "badge": "bun bench/badge.ts",
    "holdout": "bun bench/holdout.ts",
    "drift": "bun bench/drift.ts",
    "calibrate": "bun bench/calibrate.ts",
    "report": "bun bench/report.ts",
    "check": "bun run typecheck && bun test && bun run build:site",
    "typecheck": "tsc --noEmit",
    "check:site": "bun test site && bun run build:site",
    "check:browser": "bun site/verify.ts",
    "build:site": "bun run site/build.ts"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.8.0",
    "@hraness/site-footer": "github:hraness/site-footer#v0.12.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
